# Copy to .env for local development. Set the same keys on the host in production.
ENVIRONMENT=development

# The Next.js frontend's origin (CORS, email links, checkout redirects).
APP_URL=http://localhost:3000
# Extra allowed origins, comma-separated (e.g. Vercel preview URLs).
CORS_ORIGINS=

# Supabase: Project Settings -> API. The service role key bypasses RLS; never expose it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Hosted AI for paid plans and the Free trial (users without their own key).
GROQ_API_KEY=

# Encrypts users' own AI keys at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every saved user key unreadable (users would have to add them again).
# To rotate: put the new key first, comma, old key; remove the old one later.
BYOK_ENCRYPTION_KEY=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

RESEND_API_KEY=
RESEND_FROM=JobAgent <noreply@yourdomain.com>

# The scheduler sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Comma-separated. Admins also need profiles.is_admin = true.
ADMIN_EMAILS=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PREMIUM_PLAN_ID=

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_PREMIUM_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Error reporting; leave empty to disable.
SENTRY_DSN=
