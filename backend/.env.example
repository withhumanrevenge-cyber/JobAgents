# backend/.env.example
# Copy to .env and fill in your values

# App
APP_NAME="JobAgent API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq
GROQ_API_KEY=your-groq-api-key

# Job Sources
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Email (Resend)
RESEND_API_KEY=re_your-resend-key
RESEND_FROM=JobAgent <noreply@yourdomain.com>

# Cron
CRON_SECRET=your-cron-secret-change-in-production

# Razorpay (India / INR)
RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_PRO_PLAN_ID=plan_pro_id
RAZORPAY_PREMIUM_PLAN_ID=plan_premium_id

# Lemon Squeezy (International / USD)
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_PRO_VARIANT_ID=your-pro-variant-id
LEMONSQUEEZY_PREMIUM_VARIANT_ID=your-premium-variant-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# Admin
ADMIN_EMAILS=admin@example.com,another@example.com

# Optional: Redis for rate limiting
REDIS_URL=redis://localhost:6379

# Optional: Sentry
SENTRY_DSN=https://your-sentry-dsn

# Optional: Direct Database URL (if not using Supabase client)
DATABASE_URL=postgresql://user:pass@host:5432/db