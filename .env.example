# Next.js frontend. Copy to .env.local for local dev; set the same keys on Vercel.
# Server secrets (Groq, payments, service role, cron, email) belong to the Python backend:
# see backend/.env.example.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Python backend (backend/). Every API call from the browser goes here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (anon key only; the browser and the auth callback use it)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
